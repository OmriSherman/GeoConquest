# Copy this file to .env and fill in your Supabase project credentials.
# Find these in: Supabase Dashboard → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AdMob app ids (required to avoid startup crash when ads SDK is bundled)
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz

# AdMob rewarded ad unit ids (required for production ad serving)
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Optional: set to 1 to force test rewarded IDs even in release builds for SDK verification
# EXPO_PUBLIC_ADMOB_FORCE_TEST_IDS=0
